# ============================================================
#  一幕·YIMU Docker 部署环境变量样例
#  用法: cp deploy/cloud/env.example .env 然后修改下列取值
# ============================================================

# 管理口令(必填,至少 8 位;未设置时管理接口不开放)
YIMU_ADMIN_PASSWORD=change-me-to-a-strong-password

# 会话签名密钥(建议:openssl rand -hex 32 生成)
YIMU_ADMIN_SESSION_SECRET=

# 访问模式:1=多用户(服务器默认) 0=单机免密(仅本机自用)
YIMU_MULTIUSER=1

# 对外端口(默认 8790)
YIMU_PORT=8790
