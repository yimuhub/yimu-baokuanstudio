{
  "_comment": "视频大模型能力表（机器可读）。docs/VIDEO_MODELS.md 的同源数据。接新模型时按本格式追加一条：match 为模型名关键字（小写包含匹配，按数组顺序先命中先胜出，越具体越靠前）。duration_clamp：系统默认时长不在 allow 中时取 clamp_to 最近的档；aspect：允许画幅枚举（空=不限）；resolution：允许分辨率档位；reject_fields：请求体中必须剔除的字段；sync/async 标协议类型；poll_interval_s / poll_timeout_s 为轮询参数。来源：各供应商官方文档（2026-10 调研）。",
  "version": "1.0",
  "updated": "2026-10-10",
  "default": {
    "protocol": "auto",
    "note": "未命中任何规则时：先试 Agnes 异步协议（base 含 /v1），再试 OpenAI 风格同步 /videos/generations；参数不钳制。"
  },
  "rules": [
    {
      "id": "agnes-video-2.5-flash",
      "match": ["agnes-video-2.5-flash"],
      "provider": "Agnes",
      "protocol": "agnes_async",
      "durations_s": [5],
      "duration_clamp": "drop_field",
      "aspect": ["9:16", "16:9"],
      "resolution": ["720p"],
      "audio": false,
      "reject_fields": ["duration", "seconds"],
      "poll_interval_s": 5,
      "poll_timeout_s": 600,
      "retry_503": {"attempts": 5, "delay_s": 20},
      "note": "时长固定 5s；传 duration/seconds 字段会 400；队列满 503 走退避重试。"
    },
    {
      "id": "agnes-video-generic",
      "match": ["agnes-video"],
      "provider": "Agnes",
      "protocol": "agnes_async",
      "durations_s": [5],
      "aspect": ["9:16", "16:9"],
      "audio": false,
      "reject_fields": ["duration", "seconds"],
      "poll_interval_s": 5,
      "poll_timeout_s": 600,
      "note": "Agnes 视频通用档（如 agnes-video-v2.0，视上游渠道可用性）。"
    },
    {
      "id": "sora",
      "match": ["sora"],
      "provider": "OpenAI",
      "protocol": "openai_async_video",
      "durations_s": [4, 8, 12],
      "duration_clamp": "nearest",
      "aspect": ["16:9", "9:16"],
      "aspect_field": "size",
      "aspect_values": {"16:9": "1280x720", "9:16": "720x1280"},
      "duration_field": "seconds",
      "audio": true,
      "poll_interval_s": 20,
      "poll_timeout_s": 600,
      "note": "Sora 2：4/8/12 秒档位，带同步音频；size 传 WxH 字符串；生成 1-5 分钟。"
    },
    {
      "id": "veo",
      "match": ["veo"],
      "provider": "Google Gemini",
      "protocol": "gemini_lro",
      "durations_s": [4, 8],
      "duration_clamp": "nearest",
      "aspect": ["16:9", "9:16"],
      "resolution": ["720p", "1080p", "4k"],
      "duration_field": "durationSeconds",
      "audio": true,
      "poll_interval_s": 10,
      "poll_timeout_s": 900,
      "auth": "x-goog-api-key",
      "note": "LRO 长任务（predictLongRunning → GET /{operation}）；4k 更贵更慢；R2V 参考图限 16:9+8s；视频续写限 720p。"
    },
    {
      "id": "kling",
      "match": ["kling"],
      "provider": "可灵 Kling (Kuaishou)",
      "protocol": "kling_task",
      "durations_s": [5, 10],
      "duration_clamp": "nearest",
      "aspect": ["16:9", "9:16", "1:1"],
      "resolution": ["720p", "1080p"],
      "audio": true,
      "audio_limits": {"native_audio_min_resolution": "1080p", "first_last_frame_min_resolution": "1080p"},
      "prompt_max_chars": 2500,
      "image_limits": {"min_side_px": 300, "max_mb": 50, "aspect_range": "1:2.5~2.5:1"},
      "poll_interval_s": 15,
      "poll_timeout_s": 900,
      "note": "2.6 协议用 contents/settings/options；支持 callback_url 回调（可替代轮询）与 external_task_id。"
    },
    {
      "id": "wan",
      "match": ["wanx", "wan2", "wan-", "万相"],
      "provider": "阿里百炼 DashScope",
      "protocol": "dashscope_async",
      "durations_s": null,
      "duration_range_s": [2, 15],
      "duration_clamp": "clamp_range",
      "aspect": ["16:9", "9:16", "1:1", "4:3", "3:4"],
      "resolution": ["720P", "1080P"],
      "audio": true,
      "required_headers": {"X-DashScope-Async": "enable"},
      "image_limits": {"max_mb": 100, "px_range": [240, 4096], "aspect_range": "1:8~8:1"},
      "task_id_ttl_h": 24,
      "poll_interval_s": 15,
      "poll_timeout_s": 1500,
      "note": "PENDING→RUNNING→SUCCEEDED/FAILED；传首帧时 ratio 被忽略随首帧；失败不计费。"
    },
    {
      "id": "pixverse",
      "match": ["pixverse"],
      "provider": "PixVerse",
      "protocol": "openai_async_video",
      "durations_s": [5, 8],
      "duration_clamp": "nearest",
      "aspect": ["16:9", "9:16", "1:1"],
      "resolution": ["360p", "540p", "720p", "1080p"],
      "audio": true,
      "poll_interval_s": 15,
      "poll_timeout_s": 900,
      "note": "5/8s；可选首尾帧与特效风格。"
    },
    {
      "id": "seedance",
      "match": ["seedance"],
      "provider": "字节 ByteDance",
      "protocol": "openai_async_video",
      "duration_range_s": [2, 12],
      "duration_clamp": "clamp_range",
      "aspect": ["16:9", "9:16", "1:1", "4:3", "3:4", "21:9", "9:21"],
      "resolution": ["480p", "720p", "1080p"],
      "audio": true,
      "poll_interval_s": 15,
      "poll_timeout_s": 900,
      "note": "2-12s；支持 1-4 张参考图与首尾帧锁定。"
    }
  ]
}
