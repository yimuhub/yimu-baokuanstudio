# 一幕·YIMU 环境变量配置示例模板
# 复制为 .env 使用，或通过系统环境变量注入（禁止将带真实密钥的 .env 提交到 git）

# 会话签名密钥（必须：生产环境请使用随机生成的长字符串，如 openssl rand -hex 32）
YIMU_SECRET_KEY=yimu-dev-secret-key-change-this-in-production-123456

# 管理员密码
ADMIN_PASSWORD=local-admin

# 数据库路径（默认为本地 SQLite）
YIMU_DB_URL=sqlite:///./data/mediaflow.db

# 模型服务 Key（按需配置）
# MEDIAFLOW_APIPOOL_KEY=
# MEDIAFLOW_KEY_CUSTOM=
# MEDIAFLOW_KEY_YIMU_OFFICIAL=
# PEXELS_API_KEY=
